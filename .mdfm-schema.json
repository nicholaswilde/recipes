{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["comments", "tags", "hero"],
  "properties": {
    "comments": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hero": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\[\\]]+$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    }
  }
}
