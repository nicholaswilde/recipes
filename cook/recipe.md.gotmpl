---
comments: true
{{- if .Info.Tags }}
tags:
{{ toYaml .Info.Tags | indent 2 }}
{{- end }}
{{- if .Info.ImageSlug }}
hero: assets/images/{{ .Info.ImageSlug }}
{{- else if .Frontmatter.hero }}
hero: {{ toYaml .Frontmatter.hero }}
{{- end }}
{{- range $k, $v := .Frontmatter }}
{{- if and (ne $k "tags") (ne $k "title") (ne $k "category") (ne $k "comments") (ne $k "hero") }}
{{ $k }}: {{ toYaml $v }}
{{- end }}
{{- end }}
---

{{ template "cook.headerSection" . }}
{{- if .Info.ImageSlug }}

![{{ .Info.RecipeName }}][1]{ loading=lazy }
{{- end }}

{{ template "cook.tableSection" . }}

{{ template "cook.ingredientsSection" . }}

{{ template "cook.cookwareSection" . }}

{{ template "cook.stepsSection" . -}}

{{ template "cook.sourceSection" . }}
{{- if .Info.ImageSlug }}

[1]: <{{ .Info.RelRoot }}/assets/images/{{ .Info.ImageSlug }}>
{{- end }}
