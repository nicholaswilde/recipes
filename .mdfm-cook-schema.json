{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "servings": {
      "type": ["integer", "number", "string"]
    },
    "prep time": {
      "type": "string",
      "minLength": 1
    },
    "cook time": {
      "type": "string",
      "minLength": 1
    },
    "total time": {
      "type": "string",
      "minLength": 1
    }
  }
}
